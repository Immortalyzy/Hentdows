{
  "name": "hentdows",
  "version": "0.7.0",
  "private": true,
  "description": "A portrait-first Windows port of Hentoid",
  "license": "Apache-2.0",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "smoke": "electron scripts/smoke.cjs",
    "smoke:network": "electron scripts/network-smoke.cjs",
    "smoke:library": "electron scripts/library-smoke.cjs",
    "benchmark:library": "node scripts/library-benchmark.cjs",
    "package": "electron-packager . Hentdows --platform=win32 --arch=x64 --out=dist --overwrite --ignore=\"^/(Hentoid|test|docs|scripts|artifacts|dist|\\.npm-cache|\\.git)(/|$)\"",
    "smoke:reader": "electron scripts/reader-smoke.cjs",
    "smoke:queue": "electron scripts/queue-smoke.cjs",
    "smoke:browser": "electron scripts/browser-smoke.cjs",
    "smoke:import": "electron scripts/import-smoke.cjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "cheerio": "1.1.2"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "@electron/packager": "20.3.0"
  }
}
